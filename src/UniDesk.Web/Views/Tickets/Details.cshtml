@model UniDesk.Web.ViewModels.TicketDetailsViewModel

@{
    ViewData["Title"] = "Szczegóły zgłoszenia";
}

<div class="mb-4">
    <h1 class="fw-semibold">Szczegóły zgłoszenia</h1>
</div>

<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Informacje</h5>

        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-primary">
            Edytuj
        </a>
    </div>

    <div class="card-body">
        <p><strong>Tytuł:</strong> @Model.Title</p>
        <p><strong>Opis:</strong> @Model.Description</p>
        <p><strong>Status:</strong> @Model.Status</p>
        <p><strong>Autor:</strong> @(Model.OwnerName ?? "Brak danych")</p>
        <p class="mb-0"><strong>Data:</strong> @Model.CreatedAt</p>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="card-header bg-white">
        <h5 class="mb-0">Dyskusja</h5>
    </div>

    <div class="card-body">
        @if (!Model.CanUseDiscussion)
        {
            <div class="alert alert-warning mb-0">
                Nie masz dostępu do dyskusji tej sprawy.
            </div>
        }
        else
        {
            @if (Model.Comments.Count == 0)
            {
                <p class="text-muted">Brak komentarzy.</p>
            }
            else
            {
                @foreach (var comment in Model.Comments)
                {
                    <div class="border rounded p-3 mb-3 bg-light">
                        <div>@Html.Raw(comment.MessageHtml)</div>
                        <small class="text-muted">
                            @comment.AuthorName,
                            @comment.CreatedAt.ToLocalTime()
                        </small>
                    </div>
                }
            }

            <hr />

            <h5 class="mb-3">Dodaj komentarz</h5>

            <form method="post" asp-action="AddComment" asp-route-ticketId="@Model.Id">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <textarea asp-for="NewComment.Message"
                              minlength="3"
                              maxlength="1000"
                              rows="5"
                              class="form-control"></textarea>
                    <span asp-validation-for="NewComment.Message" class="text-danger"></span>
                </div>
                
                <button type="submit" class="btn btn-primary">
                    Dodaj komentarz
                </button>
            </form>
        }
    </div>
</div>

<div class="mt-3">
    <a asp-action="Index" class="btn btn-link px-0">
        Powrót do listy
    </a>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}