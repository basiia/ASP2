@using UniDesk.Web.Models
@model UniDesk.Web.ViewModels.TicketEditViewModel

<h1>Edytuj zgloszenie</h1>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post">
    @Html.AntiForgeryToken()

    <input type="hidden" asp-for="Id" />

    <div asp-validation-summary="All" style="color:red"></div>

    <div>
        <label asp-for="Title">Tytul:</label>
        <input asp-for="Title" />
        <span asp-validation-for="Title" style="color:red"></span>
    </div>

    <div>
        <label asp-for="Description">Opis:</label>
        <textarea asp-for="Description"></textarea>
        <span asp-validation-for="Description" style="color:red"></span>
    </div>

    <div>
        <label asp-for="Status">Status:</label>
        <select asp-for="Status">
            @foreach (var status in Enum.GetValues<TicketStatus>())
            {
                <option value="@status" selected="@(Model.Status == status ? "selected" : null)">
                    @status
                </option>
            }
        </select>
        <span asp-validation-for="Status" style="color:red"></span>
    </div>

    <button type="submit">Zaktualizuj</button>
</form>

<p>
    <a asp-action="Details" asp-route-id="@Model.Id">Powrot do szczegolow</a>
</p>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
