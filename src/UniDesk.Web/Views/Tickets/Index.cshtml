@using UniDesk.Web.DTOs
@using UniDesk.Web.Models
@model UniDesk.Web.DTOs.PagedResult<UniDesk.Web.DTOs.TicketListDto>

<h1>Lista zgłoszeń</h1>

<p>Łączna liczba zgłoszeń: @Model.TotalCount</p>

<h3>Dodaj zgłoszenie</h3>

<form method="post" asp-action="Create">

    @Html.AntiForgeryToken()

    <div asp-validation-summary="All" style="color:red"></div>

    <div>
        <label>Tytuł</label>
        <input type="text" name="Title" />
    </div>

    <div>
        <label>Opis</label>
        <input type="text" name="Description" />
    </div>

    <button type="submit">Dodaj</button>

</form>

<hr>

<h3>Filtruj zgłoszenia</h3>

<form method="get">
    @{
        var selectedStatus = Context.Request.Query["status"].ToString();
    }

    <select name="status">
        <option value="">Wszystkie statusy</option>

        @foreach (var status in Enum.GetValues<TicketStatus>())
        {
            <option value="@status" selected="@(selectedStatus == status.ToString() ? "selected" : null)">
                @status
            </option>
        }
    </select>

    <button type="submit">Filtruj</button>
</form>
<hr>

<ul>
    @foreach (var ticket in Model.Items)
    {
        <li>
            <a asp-action="Details" asp-route-id="@ticket.Id">
                <strong>@ticket.Title</strong>
            </a>
            -

            @if (ticket.Status == "Open")
            {
                <span style="color:green">@ticket.Status</span>
            }
            else if (ticket.Status == "InProgress")
            {
                <span style="color:orange">@ticket.Status</span>
            }
            else if (ticket.Status == "Closed")
            {
                <span style="color:gray">@ticket.Status</span>
            }

            @if (User.IsInRole("Admin"))
            {
                <form method="post" asp-action="Delete" asp-route-id="@ticket.Id" style="display:inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-sm btn-danger">
                        Usuń
                    </button>
                </form>
            }
        </li>

    }
</ul>

<hr>

<h3>Stronicowanie</h3>

@{
    var currentStatus = Context.Request.Query["status"].ToString();
}

<a asp-action="Index" asp-route-page="1" asp-route-status="@currentStatus">1</a>
<a asp-action="Index" asp-route-page="2" asp-route-status="@currentStatus">2</a>
<a asp-action="Index" asp-route-page="3" asp-route-status="@currentStatus">3</a>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}