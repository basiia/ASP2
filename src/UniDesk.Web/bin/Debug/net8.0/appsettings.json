{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=UniDesk.db"
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "Diagnostics": {
    "MinimumFreeDiskSpaceMb": 100
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    }
  },

  "AllowedHosts": "*"
}